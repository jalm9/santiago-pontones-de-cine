---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'prensa'>;
}

const { entry } = Astro.props;

// Formato corto tipo "19 feb 2026" a partir de la fecha_humana ISO
// (dejamos el string que viene en el YAML porque ya está formateado)
---

<a href={`/prensa/${entry.id}/`}>
  <span class="fecha">{entry.data.fecha_humana}</span>
  <span>
    <span class="titulo">{entry.data.title}</span>
    <span class="medio">{entry.data.medio}</span>
  </span>
</a>

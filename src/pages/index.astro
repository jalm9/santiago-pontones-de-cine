---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import QuevedoDestacado from '../components/QuevedoDestacado.astro';
import TeaserVideo from '../components/TeaserVideo.astro';
import CastingQuevedo from '../components/CastingQuevedo.astro';
import CartelHero from '../components/CartelHero.astro';
import PrensaLink from '../components/PrensaLink.astro';

// --- Documentales ordenados ---
const documentales = (await getCollection('documentales')).sort(
  (a, b) => a.data.order - b.data.order
);
const quevedo = documentales.find((d) => d.id === 'quevedo');
const otros = documentales.filter((d) => d.id !== 'quevedo');
if (!quevedo) throw new Error('Falta el documental de Quevedo.');

// --- Prensa ordenada por fecha descendente ---
const notasPrensa = (await getCollection('prensa')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

// --- Logos: los ficheros viven en src/assets/logos y se importan
//     dinámicamente para pasarlos por el pipeline de <Image>.
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/logos/*.{jpg,jpeg,png}',
  { eager: true }
);
const logo = (name: string): ImageMetadata => {
  const key = Object.keys(logoModules).find((k) => k.endsWith(`/${name}`));
  if (!key) throw new Error(`Logo no encontrado: ${name}`);
  return logoModules[key].default;
};

const patrocinadores = [
  { file: 'diputacion-jaen.jpg', alt: 'Diputación de Jaén' },
  { file: 'ayuntamiento-santiago-pontones.png', alt: 'Ayuntamiento de Santiago-Pontones' },
  { file: 'ayuntamiento-jaen.jpeg', alt: 'Ayuntamiento de Jaén' },
  { file: 'ayuntamiento-yeste.png', alt: 'Ayuntamiento de Yeste' },
  { file: 'ayuntamiento-nerpio.png', alt: 'Ayuntamiento de Nerpio' },
  { file: 'ayuntamiento-orcera.jpg', alt: 'Ayuntamiento de Orcera' },
];

const colaboradores = [
  { file: 'ecomuseo-alma-serrana.jpeg', alt: 'Ecomuseo Etnográfico Alma Serrana' },
  { file: 'fundacion-miguel-hernandez.jpeg', alt: 'Fundación Miguel Hernández' },
  { file: 'universidad-jaen.jpeg', alt: 'Universidad de Jaén' },
  { file: 'asoc-memoria-historica.jpeg', alt: 'Asociación para la Recuperación de la Memoria Histórica' },
  { file: 'federacion-andaluza-memoria-democratica.jpg', alt: 'Federación Andaluza de Memoria Democrática' },
  { file: 'la-espartena.jpeg', alt: 'Asociación Cultural La Esparteña' },
  { file: 'diario-jaen.jpeg', alt: 'Diario Jaén' },
  { file: 'radio-jaen-ser.jpeg', alt: 'Radio Jaén Cadena SER' },
  { file: 'canal-sur-jaen.jpeg', alt: 'Canal Sur Radio Jaén' },
  { file: 'canal-sur-cordoba.jpeg', alt: 'Canal Sur Radio Córdoba' },
  { file: 'radio-villacarrillo.jpeg', alt: 'Radio Villacarrillo' },
  { file: 'radio-sierra.jpeg', alt: 'Radio Sierra' },
  { file: 'cucha-que-podcast.jpeg', alt: 'Cucha Qué Podcast' },
  { file: 'libreria-metropolis.jpeg', alt: 'Librería Metrópolis' },
  { file: 'imprenta-veracruz.jpg', alt: 'Imprenta Veracruz' },
  { file: 'segura-activa.png', alt: 'Segura Activa' },
  { file: 'aventura-hernan-pelea.png', alt: 'Aventura Hernán Pelea' },
  { file: 'rio-madera.jpg', alt: 'Apartamentos Rurales Río Madera' },
  { file: 'casa-los-chaparrales.jpg', alt: 'Casa los Chaparrales' },
  { file: 'paraiso-secreto.jpg', alt: 'Resort Rural El Paraíso Secreto' },
  { file: 'hospederia-zumeta.jpg', alt: 'Hospedería Zumeta' },
  { file: 'camping-garrote-gordo.jpg', alt: 'Camping Garrote Gordo' },
  { file: 'inmobiliaria-romero.jpeg', alt: 'Inmobiliaria Romero Jaén' },
  { file: 'alojamientos-la-vega.png', alt: 'Alojamientos La Vega' },
];

// Pie de cada cartel de la cartelera
const piesCartelera: Record<string, string> = {
  bombardeo: '1 de abril de 1937, la tarde que arrasó media ciudad.',
  maquis: 'Primer premio en el Festival Internacional de Cine de Mumbai.',
  maderadas: 'El oficio de pinero ganchero, de la sierra al mar.',
};
---

<Base title="Santiago-Pontones de cine — Documentales de la Sierra de Segura">
  <QuevedoDestacado entry={quevedo} />

  <TeaserVideo
    title={quevedo.data.title}
    poster={quevedo.data.poster}
    videoSrc="/videos/quevedo-teaser.mp4"
  />

  <CastingQuevedo />

  <section class="hero wrap" id="documentales">
    <h1>La memoria de la Sierra de Segura, <em>contada en imágenes</em></h1>
    <p class="lede">
      Tres documentales sobre lo que pasó en estas montañas: los últimos maquis del valle del
      Segura, el bombardeo de Jaén de 1937 y los gancheros que bajaban la madera por el río.
    </p>

    <div class="cartelera">
      {otros.map((d) => (
        <CartelHero entry={d} pie={piesCartelera[d.id]} />
      ))}
    </div>
  </section>

  <hr class="rule" />

  <section id="proyecto" class="wrap">
    <div class="dos">
      <div>
        <p class="sub">El proyecto</p>
        <h2>Santiago-Pontones de cine</h2>
        <p>
          Nace para divulgar eventos, proyectos e iniciativas locales de interés turístico y cultural
          en el municipio de Santiago-Pontones, para visibilizar su patrimonio histórico-cultural,
          medioambiental y etnográfico, y para dignificar a todos los serranos y serranas que
          engrandecieron con su aportación y su sacrificio nuestra historia.
        </p>
      </div>
      <div>
        <p class="sub">Asociación Cultural Alma Serrana</p>
        <h3>El Ecomuseo de Los Anchos</h3>
        <p style="margin-top:1.1rem">
          En la aldea de Los Anchos, el Ecomuseo Alma Serrana mantiene sus puertas abiertas desde
          2002 con el objetivo de recopilar y poner en valor el patrimonio natural y cultural de la
          Sierra de Segura. Su recorrido cuenta la historia de la sierra y de sus habitantes, sus
          costumbres y sus labores: un modo de vida muy ligado a la naturaleza y al aprovechamiento
          de sus recursos.
        </p>
        <p>
          En 2003 recibió el I Premio Pino Galapán, otorgado por la Asociación para el Desarrollo
          Rural de la Sierra de Segura en reconocimiento a su labor de divulgación y conservación
          del patrimonio histórico serrano.
        </p>
        <p>
          <a
            href="https://lugaresmiticosdejaen.com/es/articulos/lugares/ecomuseo-alma-serrana"
            style="color:var(--ambar);text-decoration:none;border-bottom:1px solid var(--borde)"
            >Visitar el Ecomuseo</a
          >
        </p>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section id="prensa" class="wrap">
    <p class="sub">Han hablado de nosotros</p>
    <h2>Prensa</h2>

    <div class="prensa">
      {notasPrensa.map((n) => <PrensaLink entry={n} />)}
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap apoyos">
    <div>
      <p class="sub">Con el apoyo de</p>
      <h3>Patrocinadores</h3>
      <div class="logos logos--grandes">
        {patrocinadores.map(({ file, alt }) => (
          <div>
            <Image src={logo(file)} alt={alt} widths={[200, 400]} sizes="240px" />
          </div>
        ))}
      </div>
    </div>

    <div>
      <h3>Colaboradores</h3>
      <p class="nota">Veinticuatro entidades, empresas y medios de la comarca acompañan estos proyectos.</p>
      <div class="logos">
        {colaboradores.map(({ file, alt }) => (
          <div>
            <Image src={logo(file)} alt={alt} widths={[160, 260]} sizes="160px" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="colabora" class="colabora">
    <div class="wrap">
      <p class="sub">Colabora</p>
      <h2>Estos documentales se hacen entre muchos</h2>
      <p style="margin-top:1.2rem">
        Si quieres apoyar la investigación, el rodaje y la conservación de esta memoria, puedes
        hacer una donación a la cuenta de la asociación.
      </p>
      <p class="iban">ES45 3067 0107 4338 4611 2724</p>
    </div>
  </section>
</Base>
